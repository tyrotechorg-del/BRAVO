                  "key": "title",
                  "value": "My New Song",
                  "type": "text"
                },
                {
                  "key": "genre",
                  "value": "Afrobeat",
                  "type": "text"
                },
                {
                  "key": "audio",
                  "type": "file",
                  "src": "/path/to/audio.mp3"
                },
                {
                  "key": "coverArt",
                  "type": "file",
                  "src": "/path/to/cover.jpg"
                },
                {
                  "key": "isPremium",
                  "value": "false",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "0",
