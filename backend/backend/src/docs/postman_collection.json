    {
      "name": "Songs",
      "item": [
        {
          "name": "Get All Songs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/songs?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["songs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
