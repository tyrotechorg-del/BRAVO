# ============================================================
# Bravo Music API — environment configuration
# Copy to `.env` and fill in the values, then `npm install && npm start`.
# ============================================================

# ---- REQUIRED (server will not start without these) ----

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb://127.0.0.1:27017/bravo_music

# JWT secrets — MUST be at least 32 characters each, and DIFFERENT from each other.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_DIFFERENT_long_random_string_32_chars

# ---- CORE (have sensible defaults, override as needed) ----

NODE_ENV=development
PORT=1000

# Comma-separated list of origins allowed to call the API (your frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- STATIC FILE PATHS (defaults shown; relative to the backend cwd) ----
# Uploaded avatars/cover art are served from /uploads — this is what the
# frontend's VITE_STATIC_URL must point at.
STATIC_UPLOADS_PATH=./uploads
STATIC_MUSIC_PATH=./static/music
STATIC_IMAGES_PATH=./static/images

# ---- EMAIL (verification / password reset). Optional in dev. ----
EMAIL_FROM=no-reply@bravomusics.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ---- PAYMENTS (PawaPay mobile money). Required for real payments. ----
PAWAPAY_API_KEY=
PAWAPAY_BASE_URL=
# Required in production for webhook signature verification:
PAWAPAY_WEBHOOK_SECRET=

# ---- STORAGE (image/audio). Optional — falls back to local /uploads. ----
# AWS S3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Cloudinary (alternative to S3):
CLOUDINARY_URL=

# ---- REDIS (rate limiting / caching). Optional in dev. ----
REDIS_URL=

# ---- GOOGLE OAUTH (social login). Optional. ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
